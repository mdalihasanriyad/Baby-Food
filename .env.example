# ---- SERVER-ONLY (never expose to the browser) ----
NODE_ENV=development
PORT=5000
# Allowed browser origin(s) for CORS, comma-separated
APP_URL=http://localhost:5173
# MongoDB Atlas connection string (placeholder shown; use your own restricted user)
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/babyfoodgallery?retryWrites=true&w=majority
# Signs login sessions. REQUIRED. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Product image storage. Leave IMAGE_STORAGE EMPTY to choose automatically: Cloudinary whenever all three CLOUDINARY_* values
# below are filled in (always in production), otherwise local disk (public/uploads, development only).
# Set it to 'local' or 'cloudinary' only to force one. Verify your Cloudinary values with:  npm run check-cloudinary
IMAGE_STORAGE=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public canonical address of the site (used in canonical links, Open Graph tags and the sitemap). No trailing slash.
SITE_URL=http://localhost:5173
# Optional Meta Pixel ID (digits only). The Pixel ID saved in Admin > Settings takes priority over this.
META_PIXEL_ID=
# Advanced / testing only: path of the built client page to inject SEO tags into (the server finds dist/shell.html itself).
# SEO_TEMPLATE_PATH=
# Note: the browser app reads NO environment variables. The API lives at the same address (/api), so nothing here is public.
